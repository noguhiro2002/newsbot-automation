# Copy this file to .env for local use.
# Do not commit .env.

# Docker Compose build settings. Local installs can ignore these.
# Keep CODEX CLI pinned for reproducible container builds.
NEWSBOT_CODEX_CLI_VERSION=0.145.0
NEWSBOT_UV_VERSION=0.11.9
NEWSBOT_DOCKER_UID=10001
NEWSBOT_DOCKER_GID=10001
NEWSBOT_IMAGE_TAG=local
NEWSBOT_DOCKER_CPU_LIMIT=1.0
NEWSBOT_DOCKER_MEMORY_LIMIT=1g
NEWSBOT_DOCKER_PIDS_LIMIT=256
NEWSBOT_DOCKER_LOG_MAX_SIZE=10m
NEWSBOT_DOCKER_LOG_MAX_FILES=3

# Existing webhook delivery
DISCORD_WEBHOOK_URL=

# Discord Bot / Interactive Review
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_PUBLISH_CHANNEL_ID=

# Comma-separated Discord user IDs allowed to operate reviewer buttons.
# Example: 123456789012345678,234567890123456789
DISCORD_REVIEWER_USER_IDS=

# Optional. If set, ignore interactions outside this guild.
DISCORD_ALLOWED_GUILD_ID=

# Optional. Minimum spacing between Discord message create/edit requests.
# Defaults to 1 second. Set 0 to disable local throttling.
NEWSBOT_DISCORD_MESSAGE_INTERVAL_SECONDS=1

# Optional. Command name or absolute path used by the Check Source reviewer button.
# Leave blank to use `codex` from PATH.
NEWSBOT_CODEX_BIN=

# Optional. Model passed to Codex CLI with `codex exec --model`.
# Leave blank to use the Codex CLI default model.
NEWSBOT_CODEX_MODEL=

# Optional. Reasoning effort passed to Codex CLI with `model_reasoning_effort`.
# Supported values: low, medium, high, xhigh, max. Leave blank to use Codex CLI default.
NEWSBOT_CODEX_REASONING_EFFORT=

# Optional. Lab Automation multi-agent defaults.
# Phase-specific values override NEWSBOT_CODEX_MODEL / NEWSBOT_CODEX_REASONING_EFFORT.
NEWSBOT_LAB_AUTOMATION_PHASE_1_MODEL=
NEWSBOT_LAB_AUTOMATION_PHASE_2_MODEL=
NEWSBOT_LAB_AUTOMATION_PHASE_3_MODEL=
NEWSBOT_LAB_AUTOMATION_PHASE_4_MODEL=
NEWSBOT_LAB_AUTOMATION_MASTER_MODEL=
NEWSBOT_LAB_AUTOMATION_PHASE_1_REASONING_EFFORT=
NEWSBOT_LAB_AUTOMATION_PHASE_2_REASONING_EFFORT=
NEWSBOT_LAB_AUTOMATION_PHASE_3_REASONING_EFFORT=
NEWSBOT_LAB_AUTOMATION_PHASE_4_REASONING_EFFORT=
NEWSBOT_LAB_AUTOMATION_MASTER_REASONING_EFFORT=

# Phase 4 paper API collection.
# NEWSBOT_PAPER_API_RETMAX controls the maximum normalized candidates per API.
# Register NEWSBOT_NCBI_TOOL and NEWSBOT_NCBI_EMAIL with NCBI before PubMed use.
# NCBI_API_KEY remains optional; requests are limited to 3/s without it and 10/s with it.
# Crossref mailto is recommended for its polite API pool.
NEWSBOT_PAPER_API_RETMAX=50
NEWSBOT_NCBI_TOOL=newsbot_automation
NEWSBOT_NCBI_EMAIL=
NCBI_API_KEY=
NEWSBOT_CROSSREF_MAILTO=
NEWSBOT_API_CACHE_DIR=
NEWSBOT_API_CACHE_TTL_SECONDS=21600

# Optional. Cron payload generation lookback window in days.
# Leave blank to search from the previous successful run, falling back to cadence default on the first run.
NEWSBOT_LOOKBACK_DAYS=

# Optional. Default lookback days shown in Discord /newsbot_collect_reviews.
# Defaults to NEWSBOT_LOOKBACK_DAYS, then 7.
NEWSBOT_MANUAL_REVIEW_LOOKBACK_DAYS=
NEWSBOT_REVIEW_TOPIC=lab_automation
NEWSBOT_REVIEW_CADENCE=weekly

# Cron installer/runtime defaults.
# NEWSBOT_CRON_USER may be root or a specific Linux user that has Codex CLI auth and Python access.
NEWSBOT_CRON_USER=
NEWSBOT_CRON_TZ=Asia/Tokyo
NEWSBOT_PYTHON_BIN=

# Review candidate generation: trigger daily at 08:00 JST, then run only when the last successful run is at least 2 days old.
NEWSBOT_GENERATE_REVIEW_CRON="0 8 * * *"
NEWSBOT_GENERATE_REVIEW_EVERY_DAYS=2
NEWSBOT_GENERATE_REVIEW_TOPIC=lab_automation
NEWSBOT_GENERATE_REVIEW_CADENCE=weekly

# Weekly final-review preparation: every Monday at 08:00 JST.
NEWSBOT_PREPARE_WEEKLY_CRON="0 8 * * 1"
NEWSBOT_CRON_STATE_DIR=
NEWSBOT_CODEX_LOG=
NEWSBOT_WEEKLY_LOG=

# X delivery. Use either OAuth 2.0 user-context bearer token or OAuth 1.0a.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
